# PlacePrep configuration — every value below is optional in development.
# Copy to .env only if you need to override a default.

# ── Server ────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# REQUIRED in production. The server refuses to start with the development
# default when NODE_ENV=production, rather than signing tokens with a public key.
# PP_JWT_SECRET=change-me-to-a-long-random-string
PP_JWT_TTL=12h

# ── Database ──────────────────────────────────────────────────────────────
# PP_DATABASE_FILE=./server/data/placeprep.db
# PP_DATA_DIR=./server/data

# ── Client ────────────────────────────────────────────────────────────────
# Extra CORS origins, comma-separated. Same-origin requests always pass, so this
# is only needed when the client is served from a different host to the API.
PP_CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# PP_CLIENT_DIST=./client/dist

# ── Coding evaluation engine ──────────────────────────────────────────────
# Set to false to disable code execution entirely. Do this if you cannot run the
# engine behind proper isolation — see the caveat in README.md.
PP_CODE_ENGINE_ENABLED=true
PP_CODE_TIMEOUT_MS=5000
PP_COMPILE_TIMEOUT_MS=20000
PP_CODE_MAX_CONCURRENT=4
# PP_SANDBOX_DIR=./server/.sandbox

# ── Seeding ───────────────────────────────────────────────────────────────
# Password given to the seeded demo accounts.
PP_DEMO_PASSWORD=Passw0rd!

# Seed the content catalogue on boot when the database holds an older one.
# Seeding is idempotent and never deletes student work. Set to 0 to manage
# seeding by hand with `npm run db:seed`.
PP_AUTO_SEED=1
