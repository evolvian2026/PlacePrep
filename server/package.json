{
  "name": "@placeprep/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node -e \"const f=require('node:fs');f.cpSync('src/db/migrations','dist/db/migrations',{recursive:true});f.cpSync('src/db/seed/data','dist/db/seed/data',{recursive:true});f.cpSync('src/engines/runner.py','dist/engines/runner.py')\"",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx src/db/cli.ts migrate",
    "db:seed": "tsx src/db/cli.ts seed",
    "db:reset": "tsx src/db/cli.ts reset",
    "verify:coding": "tsx scripts/verify-coding.ts",
    "verify:questions": "tsx scripts/verify-questions.ts",
    "audit:mocks": "tsx scripts/audit-mocks.ts",
    "audit:db": "tsx scripts/audit-integrity.ts",
    "measure:repeats": "tsx scripts/measure-repeats.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
